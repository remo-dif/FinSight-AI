# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
# Set your own password; URL-encode it in DATABASE_URL if it contains reserved characters.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://finance:REPLACE-WITH-YOUR-POSTGRES-PASSWORD@postgres:5432/finance_ai

# Auth - generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE-THIS-WITH-A-64-CHAR-RANDOM-SECRET-USE-openssl-rand-hex-32
JWT_REFRESH_SECRET_KEY=REPLACE-THIS-WITH-A-DIFFERENT-64-CHAR-RANDOM-SECRET-VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Explicit local embeddings are for development; remote failures never switch models.
EMBEDDING_BACKEND=openai
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
OPENAI_CIRCUIT_RESET_SECONDS=30

# Storage. Production requires s3; local is for development and tests only.
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
# Hard upper bounds; deployments may only choose stricter positive values.
DOCUMENT_MAX_EXTRACTED_CHARS=1000000
DOCUMENT_MAX_CHUNKS=128
S3_UPLOAD_BUCKET=
S3_UPLOAD_PREFIX=uploads
# Optional customer-managed KMS key. When unset, uploads use S3-managed AES-256 encryption.
S3_KMS_KEY_ID=

# Redis
# Generate e.g. with openssl rand -hex 32. At least 32 URL-safe characters.
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE-WITH-YOUR-REDIS-PASSWORD@redis:6379/0
# Production requires redis so limits are shared across ECS tasks.
RATE_LIMIT_BACKEND=memory

# Comma-separated CIDRs allowed to supply X-Forwarded-For. In AWS, set this to
# the VPC/subnet CIDRs from which the ALB connects to ECS.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# CORS and rate limiting
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
