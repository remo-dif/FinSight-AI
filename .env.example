# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://finance:finance@postgres:5432/finance_ai

# Auth - generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE-THIS-WITH-A-64-CHAR-RANDOM-SECRET-USE-openssl-rand-hex-32
JWT_REFRESH_SECRET_KEY=REPLACE-THIS-WITH-A-DIFFERENT-64-CHAR-RANDOM-SECRET-VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# Redis
REDIS_URL=redis://redis:6379/0

# CORS and rate limiting
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
