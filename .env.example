# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
# Set your own password; URL-encode it in DATABASE_URL if it contains reserved characters.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://finance:REPLACE-WITH-YOUR-POSTGRES-PASSWORD@postgres:5432/finance_ai

# Auth - generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE-THIS-WITH-A-64-CHAR-RANDOM-SECRET-USE-openssl-rand-hex-32
JWT_REFRESH_SECRET_KEY=REPLACE-THIS-WITH-A-DIFFERENT-64-CHAR-RANDOM-SECRET-VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
# Required (at least 10 characters), even for EMBEDDING_BACKEND=local.
# Remote AI requires a valid provider key. A development placeholder is NOT an
# offline switch: chat still attempts remote calls. Never use one in production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Explicit local embeddings are for development; remote failures never switch models.
EMBEDDING_BACKEND=openai
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
OPENAI_CIRCUIT_RESET_SECONDS=30

# Storage. Production requires s3; local is for development and tests only.
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
# Hard upper bounds; deployments may only choose stricter positive values.
DOCUMENT_MAX_EXTRACTED_CHARS=1000000
DOCUMENT_MAX_CHUNKS=128
S3_UPLOAD_BUCKET=
S3_UPLOAD_PREFIX=uploads
# Optional customer-managed KMS key. When unset, uploads use S3-managed AES-256 encryption.
S3_KMS_KEY_ID=

# Redis
# Generate e.g. with openssl rand -hex 32. At least 32 URL-safe characters.
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE-WITH-YOUR-REDIS-PASSWORD@redis:6379/0
# Production requires redis so limits are shared across ECS tasks.
# Docker Compose explicitly overrides this to redis; memory is for direct local runs.
RATE_LIMIT_BACKEND=memory

# Explicit proxy CIDRs only; private networks are not automatically trusted.
# For CloudFront -> ALB -> ECS, configure the actual ALB peer ranges AND verified
# upstream proxy ranges if viewer IP resolution is required. Do not trust an
# entire VPC by default. Proxies must append/overwrite headers as documented.
# Keep Uvicorn --no-proxy-headers; see docs/23-proxy-auth-container-hardening.md.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# CORS and rate limiting
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
# Additional POST /api/auth/login attempts per client IP per minute (1..1000).
# Includes successful/failed attempts; no permanent lockout. Shared NATs share this IP budget.
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Frontend
# Compose fixes this build-time browser URL to localhost:8000; production images
# leave it unset for same-origin /api calls. API_INTERNAL_URL is server-only.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Additional fixed-minute login budget shared by a private HMAC account identifier.
LOGIN_ACCOUNT_RATE_LIMIT_PER_MINUTE=20
